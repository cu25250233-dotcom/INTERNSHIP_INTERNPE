import tkinter as tk

ROWS = 6
COLS = 7

# Board data
board = [
    [""] * COLS
    for _ in range(ROWS)
]

# Store GUI labels
labels = []

# Current player
current_player = "Red"


# Create the board
def create_board():

    for r in range(ROWS):

        label_row = []

        for c in range(COLS):

            label = tk.Label(
                root,
                width=5,
                height=2,
                relief="solid",
                font=("Arial", 18, "bold"),
                bg="white"
            )

            label.grid(row=r + 2, column=c)

            label_row.append(label)

        labels.append(label_row)


# Update board colours
def update_board():

    for r in range(ROWS):

        for c in range(COLS):

            if board[r][c] == "Red":
                labels[r][c].config(bg="red")

            elif board[r][c] == "Yellow":
                labels[r][c].config(bg="yellow")

            else:
                labels[r][c].config(bg="white")


# Check whether a player has won
def check_winner(player):

    # Horizontal
    for r in range(ROWS):
        for c in range(COLS - 3):

            if (
                board[r][c] == player and
                board[r][c + 1] == player and
                board[r][c + 2] == player and
                board[r][c + 3] == player
            ):
                return True

    # Vertical
    for r in range(ROWS - 3):
        for c in range(COLS):

            if (
                board[r][c] == player and
                board[r + 1][c] == player and
                board[r + 2][c] == player and
                board[r + 3][c] == player
            ):
                return True

    # Diagonal - down right
    for r in range(ROWS - 3):
        for c in range(COLS - 3):

            if (
                board[r][c] == player and
                board[r + 1][c + 1] == player and
                board[r + 2][c + 2] == player and
                board[r + 3][c + 3] == player
            ):
                return True

    # Diagonal - up right
    for r in range(3, ROWS):
        for c in range(COLS - 3):

            if (
                board[r][c] == player and
                board[r - 1][c + 1] == player and
                board[r - 2][c + 2] == player and
                board[r - 3][c + 3] == player
            ):
                return True

    return False


# Put a piece in a column
def drop_piece(column):

    global current_player

    # Start from bottom row
    for r in range(ROWS - 1, -1, -1):

        if board[r][column] == "":

            board[r][column] = current_player

            update_board()

            if check_winner(current_player):

                status.config(
                    text=f"{current_player} Wins!"
                )

                disable_buttons()
                return

            # Change player
            if current_player == "Red":
                current_player = "Yellow"
            else:
                current_player = "Red"

            status.config(
                text=f"{current_player}'s Turn"
            )

            return


# Disable buttons
def disable_buttons():

    for button in buttons:
        button.config(state="disabled")


# Main window
root = tk.Tk()
root.title("Connect Four")

# Status
status = tk.Label(
    root,
    text="Red's Turn",
    font=("Arial", 18, "bold")
)

status.grid(
    row=0,
    column=0,
    columnspan=COLS,
    pady=10
)


# Column buttons
buttons = []

for c in range(COLS):

    button = tk.Button(
        root,
        text=str(c + 1),
        width=5,
        command=lambda col=c: drop_piece(col)
    )

    button.grid(row=1, column=c)

    buttons.append(button)


# Create board
create_board()

# Start GUI
root.mainloop()
