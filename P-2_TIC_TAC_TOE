import tkinter as tk

# Create the main window
root = tk.Tk()
root.title("Tic Tac Toe")
root.geometry("400x450")

# Current player
current_player = "X"

# Store the buttons
buttons = []


# Check if a player has won
def check_winner():
    # Check rows
    for row in range(3):
        if (buttons[row][0]["text"] ==
            buttons[row][1]["text"] ==
            buttons[row][2]["text"] != ""):
            return True

    # Check columns
    for col in range(3):
        if (buttons[0][col]["text"] ==
            buttons[1][col]["text"] ==
            buttons[2][col]["text"] != ""):
            return True

    # Check first diagonal
    if (buttons[0][0]["text"] ==
        buttons[1][1]["text"] ==
        buttons[2][2]["text"] != ""):
        return True

    # Check second diagonal
    if (buttons[0][2]["text"] ==
        buttons[1][1]["text"] ==
        buttons[2][0]["text"] != ""):
        return True

    return False


# Check if the board is full
def board_full():
    for row in buttons:
        for button in row:
            if button["text"] == "":
                return False

    return True


# Handle button click
def button_click(row, col):
    global current_player

    # Don't allow an already occupied cell
    if buttons[row][col]["text"] != "":
        return

    # Put the player's symbol
    buttons[row][col]["text"] = current_player

    # Check for winner
    if check_winner():
        status.config(text=f"Player {current_player} Wins!")
        disable_buttons()
        return

    # Check for draw
    if board_full():
        status.config(text="It's a Draw!")
        return

    # Change player
    if current_player == "X":
        current_player = "O"
    else:
        current_player = "X"

    # Update status
    status.config(text=f"Player {current_player}'s Turn")


# Disable all buttons after the game ends
def disable_buttons():
    for row in buttons:
        for button in row:
            button.config(state="disabled")


# Status label
status = tk.Label(
    root,
    text="Player X's Turn",
    font=("Arial", 18, "bold")
)

status.grid(
    row=0,
    column=0,
    columnspan=3,
    pady=15
)


# Create the 3x3 game board
for row in range(3):

    button_row = []

    for col in range(3):

        button = tk.Button(
            root,
            text="",
            font=("Arial", 25, "bold"),
            width=5,
            height=2,
            command=lambda r=row, c=col: button_click(r, c)
        )

        button.grid(
            row=row + 1,
            column=col,
            padx=5,
            pady=5
        )

        button_row.append(button)

    buttons.append(button_row)


# Start the application
root.mainloop()
